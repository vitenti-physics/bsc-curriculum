.gitignore
# Saída de renderização do Quarto
/_book/
/.quarto/
*_files/
/site_libs/

# LaTeX (geração de PDF)
*.aux
*.log
*.out
*.toc
*.synctex.gz

# Sistema
.DS_Store
Thumbs.db

**/*.quarto_ipynb

# Saída do Quarto (website)
/_site/

# Material de referência local (não usado na construção do site)
/.vscode/
/OldDocs/

# Extrações do DadosFisica (geradas novamente pelos scripts em DadosFisica/extract/)
# extract_assets.py: imagens e páginas extraídas de DadosFisica/raw
/DadosFisica/extract/images/
# build_tidy.py: tabelas tidy geradas a partir de DadosFisica/data/transcribed
/DadosFisica/data/*.csv
# Caches de ferramentas
/DadosFisica/.mypy_cache/
